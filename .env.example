# Local dev: run `npx prisma dev -d` and paste the connection string it prints.
# Production: use a Neon (or any Postgres) connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/ecafe"

NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="e-cafe.uz"

# Cloudinary (unsigned upload preset) — create one at cloudinary.com, mark it "Unsigned"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="change-me"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="change-me"

# realtime-server (see realtime-server/.env.example) — values must match
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"
REALTIME_JWT_SECRET="change-me"
REALTIME_API_KEY="change-me"

# e-courier.uz — dispatches DELIVERY orders to a courier once marked READY.
# ECOURIER_WEBHOOK_SECRET must match e-courier's WEBHOOK_SHARED_SECRET.
ECOURIER_API_URL="https://e-courier.uz"
ECOURIER_WEBHOOK_SECRET="change-me"
