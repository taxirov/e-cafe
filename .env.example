# Local dev: run `npx prisma dev -d` and paste the connection string it prints.
# Production: use a Neon (or any Postgres) connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/ecafe"

NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="e-cafe.uz"

# realtime-server (see realtime-server/.env.example) — values must match
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"
REALTIME_JWT_SECRET="change-me"
REALTIME_API_KEY="change-me"
