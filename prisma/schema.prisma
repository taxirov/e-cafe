// e-cafe.uz — ko'p-kafeli SaaS: QR-stol, POS, oshxona ekrani, yetkazib berish

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  WAITER
  KITCHEN
  CUSTOMER
}

enum CafeStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  passwordHash  String
  fullName      String
  role          Role
  cafeId        String?
  cafe          Cafe?    @relation("CafeStaff", fields: [cafeId], references: [id])
  ownedCafe     Cafe?    @relation("CafeOwner")
  createdOrders Order[]  @relation("OrderCreatedBy")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cafeId])
}

model Cafe {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  logoUrl       String?
  bannerUrl     String?
  address       String?
  latitude      Float?
  longitude     Float?
  serviceRadiusKm Float?
  servicePolygon  Json?
  locationUrl   String?
  workingHours  String?
  contactPhone  String?
  instagramUrl  String?
  telegramUrl   String?
  deliveryFee   Decimal       @default(0) @db.Decimal(12, 2)
  minOrderTotal Decimal       @default(0) @db.Decimal(12, 2)
  status        CafeStatus    @default(PENDING)
  ownerId       String        @unique
  owner         User          @relation("CafeOwner", fields: [ownerId], references: [id])
  staff         User[]        @relation("CafeStaff")
  tables        CafeTable[]
  menuItems     MenuItem[]
  createdDishes DishCatalog[] @relation("DishCreatedByCafe")
  orders        Order[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CafeTable {
  id        String      @id @default(cuid())
  cafeId    String
  cafe      Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  label     String
  qrToken   String      @unique @default(cuid())
  status    TableStatus @default(FREE)
  orders    Order[]
  createdAt DateTime    @default(now())

  @@unique([cafeId, label])
  @@index([cafeId])
}

/// Global menu section (e.g. "Issiq taomlar", "Ichimliklar") — Super-Admin
/// managed and shared by every cafe, the same way e-mall's Category works.
model MenuCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  dishes    DishCatalog[]
  createdAt DateTime      @default(now())
}

/// Shared/global dish definition (name, description, photo) — created once
/// (by whichever cafe adds it first, or by Super Admin) and reused by every
/// cafe afterward, mirroring e-mall's CatalogProduct. Cafe-specific data
/// (price, availability, prep time, variants) lives on MenuItem.
model DishCatalog {
  id              String       @id @default(cuid())
  name            String
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  description     String?
  imageUrl        String?
  createdByCafeId String?
  createdByCafe   Cafe?        @relation("DishCreatedByCafe", fields: [createdByCafeId], references: [id], onDelete: SetNull)
  menuItems       MenuItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([categoryId])
  @@index([name])
}

/// A cafe's own listing of a shared dish — its price, availability, and
/// prep time. A cafe can list a given dish at most once (@@unique below).
model MenuItem {
  id          String            @id @default(cuid())
  cafeId      String
  cafe        Cafe              @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  dishId      String
  dish        DishCatalog       @relation(fields: [dishId], references: [id])
  /// Base price — the price a customer pays when the item has no variants.
  /// Ignored for ordering (but still shown as a "boshlab" reference) once
  /// the item has variants, since each variant carries its own price.
  price       Decimal           @db.Decimal(12, 2)
  isAvailable Boolean           @default(true)
  prepTimeMin Int?
  variants    MenuItemVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([cafeId, dishId])
  @@index([cafeId])
  @@index([dishId])
}

/// A priced option for a menu item (e.g. "Kichik" / "Katta") — when an item
/// has any variants, ordering it requires picking exactly one; its price
/// replaces the item's base price rather than adding to it.
model MenuItemVariant {
  id         String      @id @default(cuid())
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal     @db.Decimal(12, 2)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([menuItemId])
}

model Order {
  id            String         @id @default(cuid())
  cafeId        String
  cafe          Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  tableId       String?
  table         CafeTable?     @relation(fields: [tableId], references: [id])
  type          OrderType
  status        OrderStatus    @default(PENDING)
  items         OrderItem[]
  subtotal      Decimal        @db.Decimal(12, 2)
  deliveryFee   Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  customerName  String?
  customerPhone String?
  address       String?
  latitude      Float?
  longitude     Float?
  note          String?
  /// Waiter/staff who entered the order via POS — null for guest self-orders (QR / online).
  createdById   String?
  createdBy     User?          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  /// e-courier.uz order id once a DELIVERY order has been dispatched to a courier.
  courierOrderId String?
  /// Last delivery-leg status reported by e-courier.uz: searching/assigned/picked_up/delivered.
  courierStatus  String?
  courierName    String?
  courierPhone   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([cafeId])
  @@index([cafeId, status])
  @@index([tableId])
  @@index([createdAt])
}

model OrderItem {
  id           String           @id @default(cuid())
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem         @relation(fields: [menuItemId], references: [id])
  variantId    String?
  variant      MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Snapshot of the variant's name at order time — stays correct on the
  /// receipt/history even if the variant is later renamed or deleted.
  variantName  String?
  qty          Int
  priceAtOrder Decimal          @db.Decimal(12, 2)
  note         String?

  @@index([orderId])
  @@index([menuItemId])
  @@index([variantId])
}
